#!/usr/bin/env expect
set timeout 180
log_user 1

set server "121.43.113.132"
set user "root"
set pass "aaa123++++"
set remote_dir "/opt/casee-mcp-server"
set local_pkg "/tmp/casee-mcp-deploy.tar.gz"

puts "=== CaSee MCP Server Deployment ==="
puts "Target: $server"
puts "===================================="

# Step 1: Upload
puts ""
puts "Step 1/3: Uploading package..."
spawn scp $local_pkg ${user}@${server}:${remote_dir}/
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$pass\r" }
    timeout { puts "ERROR: Upload timeout"; exit 1 }
}
expect eof
puts "Upload complete"

# Step 2: Deploy
puts ""
puts "Step 2/3: Deploying on server..."
spawn ssh -o StrictHostKeyChecking=no ${user}@${server}
expect {
    "password:" { send "$pass\r" }
    timeout { puts "ERROR: SSH timeout"; exit 1 }
}

# Wait for shell prompt
expect -re {[\r\n].+[#$] $}

# Extract package
send "cd $remote_dir && tar -xzf casee-mcp-deploy.tar.gz && rm casee-mcp-deploy.tar.gz && echo EXTRACT_DONE\r"
expect "EXTRACT_DONE"
expect -re {[\r\n].+[#$] $}

# Force remove existing container
send "docker rm -f casee-mcp-server 2>/dev/null; echo REMOVE_DONE\r"
expect "REMOVE_DONE"
expect -re {[\r\n].+[#$] $}

# Build and start
send "docker compose -f docker/docker-compose.yml up -d --build 2>&1 && echo UP_DONE\r"
set timeout 300
expect "UP_DONE"
set timeout 30
expect -re {[\r\n].+[#$] $}

# Show status
send "docker compose -f docker/docker-compose.yml ps && echo STATUS_DONE\r"
expect "STATUS_DONE"
expect -re {[\r\n].+[#$] $}

# Show logs
send "docker compose -f docker/docker-compose.yml logs --tail 10 && echo LOGS_DONE\r"
expect "LOGS_DONE"
expect -re {[\r\n].+[#$] $}

send "exit\r"
expect eof

puts ""
puts "Deployment complete!"

# Step 3: Test
puts ""
puts "Step 3/3: Testing service..."
catch {exec sleep 5}

# First test - basic connectivity
catch {exec curl -s -X POST http://${server}:8100/mcp -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test-client\",\"version\":\"1.0\"}}}" --connect-timeout 5 --max-time 10 > /tmp/mcp_resp1.txt}

set resp1 [exec cat /tmp/mcp_resp1.txt]
puts "Initialize Response: $resp1"

# Extract session ID if available
set session_id ""
regexp {"sessionId":"([^"]+)"} $resp1 -> session_id

if {$session_id != ""} {
    puts "Session ID: $session_id"
    
    # Send initialized notification
    catch {exec curl -s -X POST http://${server}:8100/mcp -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" -H "Mcp-Session-Id: $session_id" -d "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}" --connect-timeout 5 --max-time 5 > /tmp/mcp_resp2.txt}
    
    # Test tools/list
    catch {exec curl -s -X POST http://${server}:8100/mcp -H "Content-Type: application/json" -H "Accept: application/json, text/event-stream" -H "Mcp-Session-Id: $session_id" -d "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}" --connect-timeout 5 --max-time 10 > /tmp/mcp_resp3.txt}
    
    set tools_resp [exec cat /tmp/mcp_resp3.txt]
    puts "Tools Response: $tools_resp"
    
    if {[regexp {"tools":\[} $tools_resp]} {
        puts "Service is working correctly! Tools are available."
    }
} elseif {[regexp {"error":} $resp1]} {
    puts "Service returned an error (this may be expected for direct HTTP access):"
    puts "  $resp1"
}

puts ""
puts "===================================="
puts "Deployment Complete!"
puts "URL: http://${server}:8100/mcp"
puts "===================================="

catch {exec rm -f /tmp/mcp_resp1.txt /tmp/mcp_resp2.txt /tmp/mcp_resp3.txt}
