# CaSee MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your CaSee API Key (get one at https://casee.me)
CASEE_API_KEY=sk_xxx

# ⚠️ Required in production: CaSee Intelligence Server (FastAPI) URL.
# MUST point to the CaSee API server (FastAPI), NOT the web portal/landing page.
# Pointing at https://casee.me (the portal) causes tools/call to return the
# portal's HTML instead of JSON intelligence data — every tool looks "successful"
# but returns {"data": "<!doctype html>..."}.
# Examples:
#   - Docker Desktop (Mac/Windows): http://host.docker.internal:8000
#   - Linux Docker (docker0 gateway): http://172.17.0.1:8000
#   - Same host, no Docker:           http://127.0.0.1:8000
# Leave empty to fall back to the SDK default (http://121.43.113.132:8000).
CASEE_API_BASE_URL=http://121.43.113.132:8000

# Optional: Request timeout in seconds
CASEE_TIMEOUT=30

# Optional: MCP transport mode (stdio / streamable-http)
MCP_TRANSPORT=stdio

# Streamable-HTTP mode settings (only used when MCP_TRANSPORT=streamable-http)
MCP_HOST=0.0.0.0
MCP_PORT=8100
MCP_PATH=/mcp