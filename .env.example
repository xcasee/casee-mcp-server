# CaSee MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: deployment-level is-server key (casee_..., created at
# https://www.casee.me → 系统配置 → API Keys).
# It is the fallback for stdio / anonymous requests; streamable-HTTP requests
# use the caller's X-API-Key instead. It is registered in BOTH is-server
# (retrieval tools) and EIRS (report / CVC-management tools). Keys created
# directly on is-server (sk_...) are not in the EIRS key store and fail
# OpenAPI tools with 40102.
# CASEE_API_KEY is still accepted as a deprecated alias.
CASEE_IS_API_KEY=casee_xxx

# ⚠️ Required in production: CaSee Intelligence Server (FastAPI) URL.
# MUST point to the CaSee API server (FastAPI), NOT the web portal/landing page.
# Pointing at https://casee.me (the portal) causes tools/call to return the
# portal's HTML instead of JSON intelligence data — every tool looks "successful"
# but returns {"data": "<!doctype html>..."}.
# Examples:
#   - Docker Desktop (Mac/Windows): http://host.docker.internal:8000
#   - Linux Docker (docker0 gateway): http://172.17.0.1:8000
#   - Same host, no Docker:           http://127.0.0.1:8000
# Leave empty to fall back to the SDK default (http://121.43.113.132:8000).
CASEE_API_BASE_URL=http://121.43.113.132:8000

# Optional: OpenAPI base for report / CVC lifecycle tools (async jobs included).
# Use the direct origin, NOT the CDN host: CDN has a ~120s single-response limit.
# Must end with /api/v1/openapi: the gateway appends /keys/whoami for auth probes
# (never /credits) and /usage-events for free-retrieval visibility.
CASEE_OPENAPI_BASE_URL=https://origin.casee.me/api/v1/openapi
# Portal origin used for share/download links.
CASEE_PORTAL_BASE_URL=https://www.casee.me

# Optional: request timeout in seconds (v1.7 download tools use the same value)
CASEE_TIMEOUT=30

# Optional: directory where casee_download_report / casee_export_intelligence /
# casee_export_ontology / casee_download_report_template write artifacts.
# Defaults to <system temp>/casee-downloads. In Docker, mount a volume here.
# CASEE_DOWNLOAD_DIR=/data/casee-downloads

# Optional: MCP transport mode (stdio / streamable-http)
MCP_TRANSPORT=stdio

# Streamable-HTTP mode settings (only used when MCP_TRANSPORT=streamable-http)
MCP_HOST=0.0.0.0
MCP_PORT=8100
MCP_PATH=/mcp

# Enforce X-API-Key on protected JSON-RPC methods (default: true).
# The gateway verifies the caller key against BOTH is-server (/v1/stats) and
# EIRS (/keys/whoami, a balance-free probe); a key that passes is-server but is
# unknown to EIRS is rejected with AUTH_KEY_PLANE_MISMATCH instead of failing
# later as 40102 inside a tool.
# Managed / streamable-HTTP deployments MUST keep this true: when disabled,
# every request falls back to CASEE_IS_API_KEY and all tenants collapse into
# one deployment tenant (monitoring shows "no business calls" per tenant).
# Only single-tenant stdio-like setups may explicitly set it to false.
MCP_REQUIRE_API_KEY=true

# Tool profile exposed via tools/list: core | full (default: core).
#   core = 18 high-frequency tools of the main chain
#          (retrieval → CVC build → semantic search → insight → report);
#          hidden tools remain callable, they just are not advertised.
#   full = all 66 tools (the previous behaviour).
MCP_TOOL_PROFILE=core

# Paid-tool confirmation token (dry_run → execute without a second confirmation).
# Tokens are stateless HMACs bound to tool + business args + TTL.
# TTL in seconds (default 1800 = 30 minutes).
# MCP_CONFIRM_TOKEN_TTL=1800
# Signing secret; defaults to CASEE_IS_API_KEY. Set a dedicated value when you
# rotate API keys or run multiple replicas behind a load balancer.
# MCP_CONFIRM_SECRET=change-me

# Startup self-check: probes is-server (/v1/stats) and EIRS (/keys/whoami) with
# CASEE_IS_API_KEY and logs one summary; a key valid on only one plane makes
# half of the tools fail with 40102.
# Streamable-HTTP forwards each caller's X-API-Key to both planes, so the env
# key is only the stdio/anonymous fallback there.
# The check is log-only by default; set true to abort startup on failure.
# MCP_STARTUP_CHECK_STRICT=false
