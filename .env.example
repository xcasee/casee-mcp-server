# CaSee MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your CaSee API Key (get one at https://casee.me)
CASEE_API_KEY=sk_xxx

# Optional: CaSee Intelligence Server URL (default: https://casee.me)
CASEE_API_BASE_URL=https://casee.me

# Optional: Request timeout in seconds
CASEE_TIMEOUT=30

# Optional: MCP transport mode (stdio / streamable-http)
MCP_TRANSPORT=stdio

# Streamable-HTTP mode settings (only used when MCP_TRANSPORT=streamable-http)
MCP_HOST=0.0.0.0
MCP_PORT=8100
MCP_PATH=/mcp